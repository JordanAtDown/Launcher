#!/bin/sh
# Lance cargo build --release avant chaque commit.
# Si le build échoue, le commit est annulé.

echo "[pre-commit] cargo build --release..."

REPO_ROOT="$(git rev-parse --show-toplevel)"
. "$HOME/.cargo/env"

cd "$REPO_ROOT" && cargo build --release 2>&1

if [ $? -ne 0 ]; then
    echo ""
    echo "[pre-commit] BUILD ECHOUE — commit annule."
    exit 1
fi

echo "[pre-commit] build ok."
